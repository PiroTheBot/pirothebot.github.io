---
import LearningLayout from '../../../layouts/LearningLayout.astro';
import BulletList from '../../../components/BulletList.astro';

const lb = '{';
const rb = '}';
---

<LearningLayout 
  title="CI/CD Pipelines"
  description="Continuous Integration & Deployment — automate building, testing, and shipping your code with every commit"
  category="DevOps"
  categoryHref="/learning/devops"
  difficulty="Intermediate"
  readTime="18 min read"
>

<!-- Section 1: The Hook -->
<section class="mb-12 md:mb-20 fade-in">
  <div class="bg-bg-card border border-border-subtle rounded-xl p-5 md:p-8 text-center">
    <p class="text-xl md:text-2xl font-medium text-text-secondary mb-2">Think of it as an</p>
    <p class="text-3xl md:text-4xl font-bold text-primary mb-4">Assembly Line</p>
    <p class="text-text-secondary text-sm md:text-base">for your code — automated, consistent, always running</p>
  </div>
</section>

<!-- Section 2: Factory Metaphor -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Factory Analogy</h2>
  
  <div class="bg-bg-card border border-border-subtle rounded-xl p-6 md:p-8 fade-in">
    <p class="text-text-secondary text-sm md:text-base mb-6 md:mb-8">
      Imagine a car factory. Raw materials come in, pass through stations for assembly, quality checks, 
      painting, and testing — then finished cars roll out. No human decides "should we test this one?" 
      Every car goes through the <span class="text-primary font-medium">same automated process</span>. 
      CI/CD does the same for your code.
    </p>
    
    <!-- Animated Factory SVG -->
    <div class="relative overflow-x-auto" id="factory-scene">
      <svg viewBox="0 0 600 200" class="w-full h-auto min-w-[480px]">
        <!-- Code Input -->
        <g class="code-input">
          <rect x="10" y="60" width="90" height="70" rx="8" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2"/>
          <text x="55" y="88" text-anchor="middle" fill="#3b82f6" font-size="12" font-weight="600">CODE</text>
          <text x="55" y="106" text-anchor="middle" fill="#666" font-size="9">git push</text>
          <text x="55" y="120" text-anchor="middle" fill="#666" font-size="9">main branch</text>
        </g>
        
        <!-- CI Phase -->
        <g class="ci-phase">
          <rect x="130" y="40" width="180" height="110" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="2"/>
          <text x="220" y="62" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="600">CONTINUOUS INTEGRATION</text>
          
          <!-- Build Station -->
          <rect x="142" y="75" width="50" height="35" rx="4" fill="#0a0a0a" stroke="#a78bfa" stroke-width="1"/>
          <text x="167" y="97" text-anchor="middle" fill="#a78bfa" font-size="9">Build</text>
          
          <!-- Test Station -->
          <rect x="200" y="75" width="50" height="35" rx="4" fill="#0a0a0a" stroke="#22d3ee" stroke-width="1"/>
          <text x="225" y="97" text-anchor="middle" fill="#22d3ee" font-size="9">Test</text>
          
          <!-- Lint Station -->
          <rect x="258" y="75" width="44" height="35" rx="4" fill="#0a0a0a" stroke="#f472b6" stroke-width="1"/>
          <text x="280" y="97" text-anchor="middle" fill="#f472b6" font-size="9">Lint</text>
          
          <!-- Mini arrows -->
          <path d="M192 93 L200 93" stroke="#525252" stroke-width="1" fill="none"/>
          <path d="M250 93 L258 93" stroke="#525252" stroke-width="1" fill="none"/>
          
          <text x="220" y="135" text-anchor="middle" fill="#666" font-size="9">Every commit triggers</text>
        </g>
        
        <!-- CD Phase -->
        <g class="cd-phase">
          <rect x="340" y="40" width="170" height="110" rx="8" fill="#1a1a1a" stroke="#00FF88" stroke-width="2"/>
          <text x="425" y="62" text-anchor="middle" fill="#00FF88" font-size="11" font-weight="600">CONTINUOUS DELIVERY</text>
          
          <!-- Package Station -->
          <rect x="352" y="75" width="50" height="35" rx="4" fill="#0a0a0a" stroke="#60a5fa" stroke-width="1"/>
          <text x="377" y="97" text-anchor="middle" fill="#60a5fa" font-size="9">Package</text>
          
          <!-- Deploy Station -->
          <rect x="410" y="75" width="50" height="35" rx="4" fill="#0a0a0a" stroke="#34d399" stroke-width="1"/>
          <text x="435" y="97" text-anchor="middle" fill="#34d399" font-size="9">Deploy</text>
          
          <!-- Verify Station -->
          <rect x="468" y="75" width="32" height="35" rx="4" fill="#0a0a0a" stroke="#fbbf24" stroke-width="1"/>
          <text x="484" y="97" text-anchor="middle" fill="#fbbf24" font-size="8">✓</text>
          
          <!-- Mini arrows -->
          <path d="M402 93 L410 93" stroke="#525252" stroke-width="1" fill="none"/>
          <path d="M460 93 L468 93" stroke="#525252" stroke-width="1" fill="none"/>
          
          <text x="425" y="135" text-anchor="middle" fill="#666" font-size="9">Auto-deploys when ready</text>
        </g>
        
        <!-- Production Output -->
        <g class="prod-output">
          <rect x="540" y="60" width="52" height="70" rx="8" fill="#1a1a1a" stroke="#00FF88" stroke-width="2"/>
          <text x="566" y="88" text-anchor="middle" fill="#00FF88" font-size="10" font-weight="600">LIVE</text>
          <text x="566" y="103" text-anchor="middle" fill="#666" font-size="8">🚀</text>
          <text x="566" y="118" text-anchor="middle" fill="#666" font-size="8">Prod</text>
        </g>
        
        <!-- Flow arrows -->
        <g class="arrows">
          <path d="M105 95 L125 95" class="flow-path" stroke="#3b82f6" stroke-width="2" fill="none"/>
          <polygon points="125,95 118,90 118,100" fill="#3b82f6"/>
          
          <path d="M315 95 L335 95" class="flow-path" stroke="#fbbf24" stroke-width="2" fill="none"/>
          <polygon points="335,95 328,90 328,100" fill="#fbbf24"/>
          
          <path d="M515 95 L535 95" class="flow-path" stroke="#00FF88" stroke-width="2" fill="none"/>
          <polygon points="535,95 528,90 528,100" fill="#00FF88"/>
        </g>
        
        <!-- Animated data packets -->
        <circle class="pulse-dot" cx="115" cy="95" r="4" fill="#3b82f6"/>
        <circle class="pulse-dot" cx="325" cy="95" r="4" fill="#fbbf24" style="animation-delay: 0.4s"/>
        <circle class="pulse-dot" cx="525" cy="95" r="4" fill="#00FF88" style="animation-delay: 0.8s"/>
        
        <!-- Labels -->
        <text x="55" y="180" text-anchor="middle" fill="#525252" font-size="10">Developer</text>
        <text x="220" y="180" text-anchor="middle" fill="#525252" font-size="10">Automation</text>
        <text x="425" y="180" text-anchor="middle" fill="#525252" font-size="10">Release</text>
        <text x="566" y="180" text-anchor="middle" fill="#525252" font-size="10">Users</text>
      </svg>
    </div>
    
    <div class="mt-8 grid md:grid-cols-3 gap-4 stagger-children">
      <div class="text-center p-4 rounded-lg bg-bg-main border border-border-subtle">
        <div class="text-3xl mb-2">👨‍💻</div>
        <p class="text-sm font-medium text-blue-400">You Push Code</p>
        <p class="text-xs text-text-muted mt-1">git commit && git push</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-primary/30">
        <div class="text-3xl mb-2">🤖</div>
        <p class="text-sm font-medium text-primary">Pipeline Runs</p>
        <p class="text-xs text-text-muted mt-1">Build → Test → Deploy</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-border-subtle">
        <div class="text-3xl mb-2">🚀</div>
        <p class="text-sm font-medium text-text-secondary">Users Get Updates</p>
        <p class="text-xs text-text-muted mt-1">Automatically, safely</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: The Problem -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Problem It Solves</h2>
  
  <div class="grid md:grid-cols-2 gap-6">
    <!-- Without CI/CD -->
    <div class="bg-bg-card border border-red-500/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-red-500 text-lg">✗</span>
        <span class="font-medium text-red-400">Manual Deployment</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre class="text-text-muted"><code><span class="comment"># Friday 5pm deployment ritual...</span>
1. "Did anyone run the tests?" 🤔
2. SSH into production server
3. git pull origin main
4. "It worked on my machine!"
5. Manually restart services
6. Hope nothing breaks over the weekend
7. It breaks. Phone rings at 2am.
8. Rollback... how? 😰</code></pre>
      </div>
      <BulletList color="red" items={[
        "Tests skipped \"just this once\"",
        "Different results on different machines",
        "Deployments are scary (done rarely)",
        "Rollback process unclear or manual",
        "No record of what was deployed when"
      ]} />
    </div>
    
    <!-- With CI/CD -->
    <div class="bg-bg-card border border-primary/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-primary text-lg">✓</span>
        <span class="font-medium text-primary">Automated Pipeline</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre><code><span class="comment"># Every git push triggers:</span>
<span class="function">on</span>: push
<span class="keyword">jobs</span>:
  <span class="type">build</span>: <span class="comment"># ✓ Compiles</span>
  <span class="type">test</span>:  <span class="comment"># ✓ 847 tests pass</span>
  <span class="type">lint</span>:  <span class="comment"># ✓ Code quality OK</span>
  <span class="type">deploy</span>: <span class="comment"># ✓ Prod updated</span>

<span class="comment"># Merge PR → Live in 3 minutes</span>
<span class="comment"># Sleep soundly 😴</span></code></pre>
      </div>
      <BulletList color="primary" items={[
        "Tests run on EVERY commit",
        "Identical environment every time",
        "Deploy 10x a day with confidence",
        "One-click rollback to any version",
        "Full audit trail of deployments"
      ]} />
    </div>
  </div>
</section>

<!-- Section 4: Core Concepts -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Core Concepts</h2>
  
  <div class="grid md:grid-cols-2 gap-4 stagger-children">
    <!-- Continuous Integration -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="ci">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-yellow-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🔄</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Continuous Integration (CI)</h3>
          <p class="text-text-muted text-sm">Automatically <span class="text-yellow-400">build and test</span> code every time someone pushes. Catch bugs early, merge confidently.</p>
        </div>
      </div>
    </div>
    
    <!-- Continuous Delivery -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="cd-delivery">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">📦</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Continuous Delivery (CD)</h3>
          <p class="text-text-muted text-sm">Code is always <span class="text-primary">ready to deploy</span>. One button to ship. Humans decide when to release.</p>
        </div>
      </div>
    </div>
    
    <!-- Continuous Deployment -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="cd-deployment">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🚀</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Continuous Deployment</h3>
          <p class="text-text-muted text-sm"><span class="text-blue-400">Fully automated</span> — every passing commit goes straight to production. No manual gates.</p>
        </div>
      </div>
    </div>
    
    <!-- Pipeline -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="pipeline">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🔗</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Pipeline</h3>
          <p class="text-text-muted text-sm">A series of <span class="text-purple-400">stages and jobs</span> that run in order. Each stage must pass before the next starts.</p>
        </div>
      </div>
    </div>
    
    <!-- Artifacts -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="artifacts">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-cyan-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">📁</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Artifacts</h3>
          <p class="text-text-muted text-sm">Output from builds — Docker images, binaries, test reports. <span class="text-cyan-400">Passed between stages</span> or stored for deployment.</p>
        </div>
      </div>
    </div>
    
    <!-- Runners/Agents -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="runners">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-pink-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🖥️</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Runners / Agents</h3>
          <p class="text-text-muted text-sm">Machines that <span class="text-pink-400">execute your pipelines</span>. Cloud-hosted or self-managed. Where your code actually runs.</p>
        </div>
      </div>
    </div>
  </div>
  
  <!-- CD Clarification -->
  <div class="mt-6 bg-bg-card border border-blue-500/30 rounded-xl p-6 fade-in">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
        <span class="text-2xl">💡</span>
      </div>
      <div>
        <h3 class="font-medium text-blue-400 mb-2">Delivery vs. Deployment — What's the Difference?</h3>
        <p class="text-text-secondary text-sm">
          <strong class="text-white">Continuous Delivery:</strong> Code is packaged and ready to deploy at any time, but a human clicks the button.<br/>
          <strong class="text-white">Continuous Deployment:</strong> Every passing build automatically goes live. No human in the loop.<br/><br/>
          Most teams start with <span class="text-primary">Delivery</span> (safer) and graduate to <span class="text-blue-400">Deployment</span> as confidence grows.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Section 5: Pipeline Stages -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Pipeline Stages</h2>
  
  <div class="bg-bg-card border border-border-subtle rounded-xl p-4 md:p-8 fade-in overflow-x-auto">
    <svg viewBox="0 0 600 220" class="w-full h-auto min-w-[480px]" id="pipeline-diagram">
      <!-- Stage 1: Source -->
      <g class="pipeline-stage" data-stage="source">
        <rect x="10" y="40" width="85" height="80" rx="8" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2" class="hover-glow cursor-pointer"/>
        <text x="52" y="65" text-anchor="middle" fill="#3b82f6" font-size="11" font-weight="600">SOURCE</text>
        <text x="52" y="82" text-anchor="middle" fill="#666" font-size="9">git push</text>
        <text x="52" y="96" text-anchor="middle" fill="#666" font-size="9">or PR</text>
        <text x="52" y="110" text-anchor="middle" fill="#3b82f6" font-size="14">📥</text>
      </g>
      
      <!-- Arrow 1 -->
      <path d="M100 80 L120 80" stroke="#3b82f6" stroke-width="2" fill="none" class="flow-path"/>
      <polygon points="120,80 113,75 113,85" fill="#3b82f6"/>
      
      <!-- Stage 2: Build -->
      <g class="pipeline-stage" data-stage="build">
        <rect x="125" y="40" width="85" height="80" rx="8" fill="#1a1a1a" stroke="#a78bfa" stroke-width="2" class="hover-glow cursor-pointer"/>
        <text x="167" y="65" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="600">BUILD</text>
        <text x="167" y="82" text-anchor="middle" fill="#666" font-size="9">Compile</text>
        <text x="167" y="96" text-anchor="middle" fill="#666" font-size="9">Dependencies</text>
        <text x="167" y="110" text-anchor="middle" fill="#a78bfa" font-size="14">🔨</text>
      </g>
      
      <!-- Arrow 2 -->
      <path d="M215 80 L235 80" stroke="#a78bfa" stroke-width="2" fill="none" class="flow-path"/>
      <polygon points="235,80 228,75 228,85" fill="#a78bfa"/>
      
      <!-- Stage 3: Test -->
      <g class="pipeline-stage" data-stage="test">
        <rect x="240" y="40" width="85" height="80" rx="8" fill="#1a1a1a" stroke="#22d3ee" stroke-width="2" class="hover-glow cursor-pointer"/>
        <text x="282" y="65" text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="600">TEST</text>
        <text x="282" y="82" text-anchor="middle" fill="#666" font-size="9">Unit / Int.</text>
        <text x="282" y="96" text-anchor="middle" fill="#666" font-size="9">Coverage</text>
        <text x="282" y="110" text-anchor="middle" fill="#22d3ee" font-size="14">🧪</text>
      </g>
      
      <!-- Arrow 3 -->
      <path d="M330 80 L350 80" stroke="#22d3ee" stroke-width="2" fill="none" class="flow-path"/>
      <polygon points="350,80 343,75 343,85" fill="#22d3ee"/>
      
      <!-- Stage 4: Package -->
      <g class="pipeline-stage" data-stage="package">
        <rect x="355" y="40" width="85" height="80" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="2" class="hover-glow cursor-pointer"/>
        <text x="397" y="65" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="600">PACKAGE</text>
        <text x="397" y="82" text-anchor="middle" fill="#666" font-size="9">Docker</text>
        <text x="397" y="96" text-anchor="middle" fill="#666" font-size="9">Image</text>
        <text x="397" y="110" text-anchor="middle" fill="#fbbf24" font-size="14">📦</text>
      </g>
      
      <!-- Arrow 4 -->
      <path d="M445 80 L465 80" stroke="#fbbf24" stroke-width="2" fill="none" class="flow-path"/>
      <polygon points="465,80 458,75 458,85" fill="#fbbf24"/>
      
      <!-- Stage 5: Deploy -->
      <g class="pipeline-stage" data-stage="deploy">
        <rect x="470" y="40" width="85" height="80" rx="8" fill="#1a1a1a" stroke="#00FF88" stroke-width="2" class="hover-glow cursor-pointer"/>
        <text x="512" y="65" text-anchor="middle" fill="#00FF88" font-size="11" font-weight="600">DEPLOY</text>
        <text x="512" y="82" text-anchor="middle" fill="#666" font-size="9">Staging</text>
        <text x="512" y="96" text-anchor="middle" fill="#666" font-size="9">→ Prod</text>
        <text x="512" y="110" text-anchor="middle" fill="#00FF88" font-size="14">🚀</text>
      </g>
      
      <!-- Success/Fail indicators -->
      <g class="status-row">
        <circle cx="52" cy="145" r="8" fill="#0a0a0a" stroke="#00FF88" stroke-width="2"/>
        <text x="52" y="149" text-anchor="middle" fill="#00FF88" font-size="10">✓</text>
        
        <circle cx="167" cy="145" r="8" fill="#0a0a0a" stroke="#00FF88" stroke-width="2"/>
        <text x="167" y="149" text-anchor="middle" fill="#00FF88" font-size="10">✓</text>
        
        <circle cx="282" cy="145" r="8" fill="#0a0a0a" stroke="#00FF88" stroke-width="2"/>
        <text x="282" y="149" text-anchor="middle" fill="#00FF88" font-size="10">✓</text>
        
        <circle cx="397" cy="145" r="8" fill="#0a0a0a" stroke="#00FF88" stroke-width="2"/>
        <text x="397" y="149" text-anchor="middle" fill="#00FF88" font-size="10">✓</text>
        
        <circle cx="512" cy="145" r="8" fill="#0a0a0a" stroke="#00FF88" stroke-width="2"/>
        <text x="512" y="149" text-anchor="middle" fill="#00FF88" font-size="10">✓</text>
      </g>
      
      <!-- Time labels -->
      <text x="52" y="175" text-anchor="middle" fill="#525252" font-size="9">0s</text>
      <text x="167" y="175" text-anchor="middle" fill="#525252" font-size="9">30s</text>
      <text x="282" y="175" text-anchor="middle" fill="#525252" font-size="9">2m</text>
      <text x="397" y="175" text-anchor="middle" fill="#525252" font-size="9">3m</text>
      <text x="512" y="175" text-anchor="middle" fill="#525252" font-size="9">5m</text>
      
      <!-- Progress bar -->
      <rect x="10" y="195" width="545" height="6" rx="3" fill="#1a1a1a"/>
      <rect x="10" y="195" width="545" height="6" rx="3" fill="#00FF88" opacity="0.3"/>
      <rect x="10" y="195" width="545" height="6" rx="3" fill="url(#progress-gradient)"/>
      
      <defs>
        <linearGradient id="progress-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#3b82f6"/>
          <stop offset="25%" stop-color="#a78bfa"/>
          <stop offset="50%" stop-color="#22d3ee"/>
          <stop offset="75%" stop-color="#fbbf24"/>
          <stop offset="100%" stop-color="#00FF88"/>
        </linearGradient>
      </defs>
    </svg>
    
    <div class="mt-6 grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
      <div>
        <span class="text-blue-400 font-medium text-sm">Source</span>
        <p class="text-text-muted text-xs mt-1">Trigger pipeline</p>
      </div>
      <div>
        <span class="text-purple-400 font-medium text-sm">Build</span>
        <p class="text-text-muted text-xs mt-1">Compile code</p>
      </div>
      <div>
