            <rect x="440" y="35" width="150" height="90" rx="8" fill="#1a1a1a" stroke="#22d3ee" stroke-width="2"/>
            <text x="515" y="60" text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="600">K8S CLUSTER</text>
            <rect x="452" y="72" width="40" height="20" rx="4" fill="#0a0a0a" stroke="#fbbf24" stroke-width="1"/>
            <text x="472" y="86" text-anchor="middle" fill="#fbbf24" font-size="8">Pod</text>
            <rect x="500" y="72" width="40" height="20" rx="4" fill="#0a0a0a" stroke="#fbbf24" stroke-width="1"/>
