            {rb}
        {rb}
        
        <span class="keyword">stage</span>(<span class="string">'Deploy to Production'</span>) {lb}
            <span class="keyword">when</span> {lb}
                <span class="type">branch</span> <span class="string">'main'</span>
            {rb}
            <span class="type">input</span> {lb}
                <span class="type">message</span> <span class="string">'Deploy to production?'</span>
                <span class="type">ok</span> <span class="string">'Deploy'</span>
            {rb}
            <span class="type">steps</span> {lb}
                <span class="function">withKubeConfig</span>([<span class="type">credentialsId</span>: <span class="string">'kubeconfig-prod'</span>]) {lb}
                    <span class="function">sh</span> <span class="string">'kubectl apply -f k8s/production/'</span>
                {rb}
            {rb}
        {rb}
    {rb}
{rb}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 7: GitOps & ArgoCD -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">GitOps & ArgoCD</h2>
  
  <!-- GitOps Philosophy -->
  <div class="mb-8 fade-in">
    <div class="bg-bg-card border border-purple-500/30 rounded-xl p-6 md:p-8">
      <div class="flex items-start gap-4 mb-6">
