            <text x="185" y="92" text-anchor="middle" fill="#666" font-size="9">k8s/service.yaml</text>
            <text x="185" y="106" text-anchor="middle" fill="#a78bfa" font-size="9">Source of Truth</text>
          </g>
          
          <!-- Arrow to ArgoCD -->
          <path d="M245 80 L280 80" stroke="#a78bfa" stroke-width="2" fill="none" class="flow-path"/>
          <polygon points="280,80 273,75 273,85" fill="#a78bfa"/>
          
