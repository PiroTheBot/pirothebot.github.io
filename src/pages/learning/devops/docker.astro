---
import LearningLayout from '../../../layouts/LearningLayout.astro';
import BulletList from '../../../components/BulletList.astro';

const lb = '{';
const rb = '}';
---

<LearningLayout 
  title="Docker & Containers"
  description="Package applications with their dependencies — run anywhere, the same way, every time"
  category="DevOps"
  categoryHref="/learning/devops"
  difficulty="Intermediate"
  readTime="15 min read"
>

<!-- Section 1: The Hook -->
<section class="mb-12 md:mb-20 fade-in">
  <div class="bg-bg-card border border-border-subtle rounded-xl p-5 md:p-8 text-center">
    <p class="text-xl md:text-2xl font-medium text-text-secondary mb-2">Think of it as a</p>
    <p class="text-3xl md:text-4xl font-bold text-primary mb-4">Shipping Container</p>
    <p class="text-text-secondary text-sm md:text-base">for your software — pack once, run anywhere</p>
  </div>
</section>

<!-- Section 2: Shipping Container Metaphor -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Shipping Container Analogy</h2>
  
  <div class="bg-bg-card border border-border-subtle rounded-xl p-6 md:p-8 fade-in">
    <p class="text-text-secondary text-sm md:text-base mb-6 md:mb-8">
      Before shipping containers, loading cargo was chaos — different shapes, sizes, handling requirements. 
      Then came standardized containers: <span class="text-primary font-medium">pack anything inside</span>, 
      and it works on any ship, truck, or crane. Docker does the same for software — package your app 
      with everything it needs, and it runs identically on any machine.
    </p>
    
    <!-- Animated Container SVG -->
    <div class="relative overflow-x-auto" id="container-scene">
      <svg viewBox="0 0 600 220" class="w-full h-auto min-w-[480px]">
        <!-- Developer Machine -->
        <g class="dev-machine" id="dev-machine">
          <rect x="10" y="50" width="130" height="100" rx="8" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2"/>
          <text x="75" y="75" text-anchor="middle" fill="#3b82f6" font-size="12" font-weight="600">YOUR LAPTOP</text>
          
          <!-- App components inside -->
          <rect x="22" y="88" width="45" height="22" rx="3" fill="#0a0a0a" stroke="#a78bfa" stroke-width="1"/>
          <text x="44" y="103" text-anchor="middle" fill="#a78bfa" font-size="8">Python 3.11</text>
          
          <rect x="72" y="88" width="55" height="22" rx="3" fill="#0a0a0a" stroke="#34d399" stroke-width="1"/>
          <text x="99" y="103" text-anchor="middle" fill="#34d399" font-size="8">Dependencies</text>
          
          <rect x="22" y="116" width="105" height="22" rx="3" fill="#0a0a0a" stroke="#fbbf24" stroke-width="1"/>
          <text x="74" y="131" text-anchor="middle" fill="#fbbf24" font-size="8">Your App Code</text>
        </g>
        
        <!-- Docker Container -->
        <g class="docker-container" id="docker-container">
          <rect x="215" y="35" width="170" height="130" rx="8" fill="#1a1a1a" stroke="#00FF88" stroke-width="2"/>
          <text x="300" y="60" text-anchor="middle" fill="#00FF88" font-size="13" font-weight="600">DOCKER CONTAINER</text>
          
          <!-- Container contents (packaged) -->
          <rect x="228" y="72" width="144" height="80" rx="4" fill="#0a0a0a" stroke="#00FF88" stroke-width="1" stroke-dasharray="4 2"/>
          
          <rect x="238" y="82" width="55" height="18" rx="2" fill="#141414" stroke="#a78bfa" stroke-width="1"/>
          <text x="265" y="95" text-anchor="middle" fill="#a78bfa" font-size="7">Python 3.11</text>
          
          <rect x="298" y="82" width="65" height="18" rx="2" fill="#141414" stroke="#34d399" stroke-width="1"/>
          <text x="330" y="95" text-anchor="middle" fill="#34d399" font-size="7">Dependencies</text>
          
          <rect x="238" y="105" width="125" height="18" rx="2" fill="#141414" stroke="#fbbf24" stroke-width="1"/>
          <text x="300" y="118" text-anchor="middle" fill="#fbbf24" font-size="7">Your App Code</text>
          
          <rect x="238" y="128" width="125" height="18" rx="2" fill="#141414" stroke="#60a5fa" stroke-width="1"/>
          <text x="300" y="141" text-anchor="middle" fill="#60a5fa" font-size="7">Linux OS Layer</text>
        </g>
        
        <!-- Production Servers -->
        <g class="servers" id="servers">
          <rect x="455" y="25" width="135" height="55" rx="6" fill="#1a1a1a" stroke="#525252" stroke-width="2"/>
          <text x="522" y="45" text-anchor="middle" fill="#888" font-size="10" font-weight="500">AWS EC2</text>
          <text x="522" y="62" text-anchor="middle" fill="#00FF88" font-size="8">✓ Same container</text>
          
          <rect x="455" y="90" width="135" height="55" rx="6" fill="#1a1a1a" stroke="#525252" stroke-width="2"/>
          <text x="522" y="110" text-anchor="middle" fill="#888" font-size="10" font-weight="500">Your Colleague's Mac</text>
          <text x="522" y="127" text-anchor="middle" fill="#00FF88" font-size="8">✓ Same container</text>
          
          <rect x="455" y="155" width="135" height="55" rx="6" fill="#1a1a1a" stroke="#525252" stroke-width="2"/>
          <text x="522" y="175" text-anchor="middle" fill="#888" font-size="10" font-weight="500">Kubernetes Cluster</text>
          <text x="522" y="192" text-anchor="middle" fill="#00FF88" font-size="8">✓ Same container</text>
        </g>
        
        <!-- Flow arrows -->
        <g class="arrows">
          <path d="M145 100 L210 100" class="flow-path" stroke="#3b82f6" stroke-width="2" fill="none"/>
          <polygon points="210,100 203,95 203,105" fill="#3b82f6"/>
          
          <path d="M390 100 L450 52" class="flow-path" stroke="#00FF88" stroke-width="2" fill="none"/>
          <polygon points="450,52 441,52 445,60" fill="#00FF88"/>
          
          <path d="M390 100 L450 117" class="flow-path" stroke="#00FF88" stroke-width="2" fill="none" style="animation-delay: 0.3s"/>
          <polygon points="450,117 441,115 443,123" fill="#00FF88"/>
          
          <path d="M390 100 L450 182" class="flow-path" stroke="#00FF88" stroke-width="2" fill="none" style="animation-delay: 0.6s"/>
          <polygon points="450,182 441,178 445,186" fill="#00FF88"/>
        </g>
        
        <!-- Labels -->
        <text x="177" y="85" text-anchor="middle" fill="#525252" font-size="9">build</text>
        <text x="420" y="85" text-anchor="middle" fill="#525252" font-size="9">ship</text>
        
        <!-- Animated data packets -->
        <circle class="pulse-dot" cx="177" cy="100" r="4" fill="#3b82f6"/>
        <circle class="pulse-dot" cx="420" cy="100" r="4" fill="#00FF88" style="animation-delay: 0.5s"/>
      </svg>
    </div>
    
    <div class="mt-8 grid md:grid-cols-3 gap-4 stagger-children">
      <div class="text-center p-4 rounded-lg bg-bg-main border border-border-subtle">
        <div class="text-3xl mb-2">💻</div>
        <p class="text-sm font-medium text-blue-400">Your Machine</p>
        <p class="text-xs text-text-muted mt-1">App + runtime + dependencies</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-primary/30">
        <div class="text-3xl mb-2">📦</div>
        <p class="text-sm font-medium text-primary">Container</p>
        <p class="text-xs text-text-muted mt-1">Everything packaged together</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-border-subtle">
        <div class="text-3xl mb-2">🌍</div>
        <p class="text-sm font-medium text-text-secondary">Anywhere</p>
        <p class="text-xs text-text-muted mt-1">Runs identical everywhere</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: The Problem -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Problem It Solves</h2>
  
  <div class="grid md:grid-cols-2 gap-6">
    <!-- Without Docker -->
    <div class="bg-bg-card border border-red-500/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-red-500 text-lg">✗</span>
        <span class="font-medium text-red-400">Without Docker</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre class="text-text-muted"><code><span class="comment"># Classic developer nightmare</span>
"Works on my machine!" 🤷

Developer A: Python 3.9, pip 21.0
Developer B: Python 3.11, pip 23.0
Production: Python 3.8, pip 19.0 😱

<span class="comment"># Manual setup on every server</span>
$ ssh prod-server
$ apt-get install python3 python3-pip
$ pip install -r requirements.txt
<span class="comment"># Pray the versions match</span>
<span class="comment"># Repeat for 50 servers...</span></code></pre>
      </div>
      <BulletList color="red" items={[
        '"Works on my machine" syndrome',
        "Dependency version conflicts",
        "Hours of manual server setup",
        "Different behavior across environments",
        "Impossible to reproduce bugs"
      ]} />
    </div>
    
    <!-- With Docker -->
    <div class="bg-bg-card border border-primary/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-primary text-lg">✓</span>
        <span class="font-medium text-primary">With Docker</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre><code><span class="comment"># Build once, run everywhere</span>
$ docker build -t myapp:1.0 .
$ docker push myapp:1.0

<span class="comment"># On ANY machine (dev, staging, prod)</span>
$ docker run myapp:1.0
<span class="comment"># ✓ Same Python version</span>
<span class="comment"># ✓ Same dependencies</span>
<span class="comment"># ✓ Same behavior</span>
<span class="comment"># Done. ☕</span></code></pre>
      </div>
      <BulletList color="primary" items={[
        "Identical environment everywhere",
        "Dependencies locked in the image",
        "Single command deployment",
        "Bugs reproduce exactly",
        "Onboard new devs in minutes"
      ]} />
    </div>
  </div>
</section>

<!-- Section 4: Core Concepts -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Core Concepts</h2>
  
  <div class="grid md:grid-cols-2 gap-4 stagger-children">
    <!-- Images -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="images">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">📀</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Images</h3>
          <p class="text-text-muted text-sm">Read-only templates containing your app + dependencies + OS. Like a snapshot or a class definition. You build them with a Dockerfile.</p>
        </div>
      </div>
    </div>
    
    <!-- Containers -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="containers">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">📦</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Containers</h3>
          <p class="text-text-muted text-sm">Running instances of images. Like objects created from a class. Isolated, lightweight, start in milliseconds. Disposable and replaceable.</p>
        </div>
      </div>
    </div>
    
    <!-- Volumes -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="volumes">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-yellow-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">💾</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Volumes</h3>
          <p class="text-text-muted text-sm">Persistent storage that survives container restarts. Containers are ephemeral — volumes keep your data safe across container lifecycles.</p>
        </div>
      </div>
    </div>
    
    <!-- Networks -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="networks">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🔗</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Networks</h3>
          <p class="text-text-muted text-sm">Isolated virtual networks for container communication. Containers in the same network can find each other by name. Isolated by default.</p>
        </div>
      </div>
    </div>
    
    <!-- Dockerfile -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="dockerfile">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">📝</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Dockerfile</h3>
          <p class="text-text-muted text-sm">The recipe for building an image. Step-by-step instructions: base image, install dependencies, copy code, configure startup command.</p>
        </div>
      </div>
    </div>
    
    <!-- Registry -->
    <div class="concept-card bg-bg-card border border-border-subtle rounded-xl p-5 cursor-pointer transition-all hover:border-primary/40" data-concept="registry">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 bg-cyan-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-2xl">🏪</span>
        </div>
        <div>
          <h3 class="font-medium text-white mb-1">Registry</h3>
          <p class="text-text-muted text-sm">Storage for images — like npm for containers. Docker Hub is public; you can use private registries (ECR, GCR, ACR) for your own images.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 5: Dockerfile Deep Dive -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Dockerfile Deep Dive</h2>
  
  <!-- Step 1 -->
  <div class="mb-8 fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-sm">1</span>
      <h3 class="font-medium text-text-secondary">Choose a Base Image</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <p class="text-text-secondary text-sm mb-4">
        Start with an existing image — usually an OS or runtime. Don't reinvent the wheel.
      </p>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
        <pre><code><span class="comment"># Official Python runtime</span>
<span class="keyword">FROM</span> python:3.11-slim

<span class="comment"># Or Node.js</span>
<span class="keyword">FROM</span> node:20-alpine

<span class="comment"># Or just Linux</span>
<span class="keyword">FROM</span> ubuntu:22.04

<span class="comment"># Pro tip: use -slim or -alpine variants for smaller images</span></code></pre>
      </div>
    </div>
  </div>
  
  <!-- Step 2 -->
  <div class="mb-8 fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-sm">2</span>
      <h3 class="font-medium text-text-secondary">Set Up the Working Directory</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <p class="text-text-secondary text-sm mb-4">
        Create a home for your application inside the container.
      </p>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
        <pre><code><span class="comment"># All subsequent commands run from here</span>
<span class="keyword">WORKDIR</span> /app

<span class="comment"># Creates the directory if it doesn't exist</span>
<span class="comment"># Sets it as the current directory</span></code></pre>
      </div>
    </div>
  </div>
  
  <!-- Step 3 -->
  <div class="mb-8 fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-sm">3</span>
      <h3 class="font-medium text-text-secondary">Install Dependencies First</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <p class="text-text-secondary text-sm mb-4">
        Copy dependency files first, then install. Docker caches layers — if dependencies don't change, this layer is reused.
      </p>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
        <pre><code><span class="comment"># Python example</span>
<span class="keyword">COPY</span> requirements.txt .
<span class="keyword">RUN</span> pip install --no-cache-dir -r requirements.txt

<span class="comment"># Node.js example</span>
<span class="keyword">COPY</span> package*.json ./
<span class="keyword">RUN</span> npm ci --only=production</code></pre>
      </div>
    </div>
  </div>
  
  <!-- Step 4 -->
  <div class="mb-8 fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-sm">4</span>
      <h3 class="font-medium text-text-secondary">Copy Application Code</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <p class="text-text-secondary text-sm mb-4">
        Copy your source code after dependencies — code changes often, dependencies don't.
      </p>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
        <pre><code><span class="comment"># Copy everything from current directory to /app</span>
<span class="keyword">COPY</span> . .

<span class="comment"># Or be specific</span>
<span class="keyword">COPY</span> src/ ./src/
<span class="keyword">COPY</span> config/ ./config/</code></pre>
      </div>
    </div>
  </div>
  
  <!-- Step 5 -->
  <div class="fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-sm">5</span>
      <h3 class="font-medium text-text-secondary">Define the Startup Command</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <p class="text-text-secondary text-sm mb-4">
        Tell Docker how to run your app. CMD is the default; ENTRYPOINT sets a fixed executable.
      </p>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
        <pre><code><span class="comment"># Expose the port your app listens on</span>
<span class="keyword">EXPOSE</span> 8000

<span class="comment"># Run the application</span>
<span class="keyword">CMD</span> [<span class="string">"python"</span>, <span class="string">"app.py"</span>]

<span class="comment"># Or for Node.js</span>
<span class="keyword">CMD</span> [<span class="string">"node"</span>, <span class="string">"server.js"</span>]

<span class="comment"># Or use npm</span>
<span class="keyword">CMD</span> [<span class="string">"npm"</span>, <span class="string">"start"</span>]</code></pre>
      </div>
    </div>
  </div>
</section>

<!-- Section 6: Code Examples with Python/Node tabs -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Complete Examples</h2>
  
  <!-- Language Switcher -->
  <div class="mb-6 fade-in">
    <div class="flex flex-wrap gap-2" id="lang-switcher">
      <button class="lang-tab active px-4 py-2 text-sm rounded-lg bg-primary/20 text-primary border border-primary/30 flex items-center gap-2" data-lang="python">
        <span class="text-lg">🐍</span> Python (Flask)
      </button>
      <button class="lang-tab px-4 py-2 text-sm rounded-lg bg-bg-main text-text-muted border border-border-subtle hover:border-border-light transition-colors flex items-center gap-2" data-lang="node">
        <span class="text-lg">💚</span> Node.js (Express)
      </button>
    </div>
  </div>
  
  <!-- Application Code -->
  <div class="mb-8 fade-in">
    <h3 class="font-medium text-text-secondary mb-4">Application Code</h3>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      
      <!-- Python App -->
      <div class="lang-content" id="lang-python-app">
        <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
          <pre><code><span class="comment"># app.py</span>
<span class="keyword">from</span> flask <span class="keyword">import</span> Flask
<span class="keyword">import</span> os

app = Flask(__name__)

@app.<span class="function">route</span>(<span class="string">'/'</span>)
<span class="keyword">def</span> <span class="function">hello</span>():
    <span class="keyword">return</span> <span class="string">'Hello from Docker! 🐳'</span>

@app.<span class="function">route</span>(<span class="string">'/health'</span>)
<span class="keyword">def</span> <span class="function">health</span>():
    <span class="keyword">return</span> {lb}<span class="string">'status'</span>: <span class="string">'healthy'</span>{rb}

<span class="keyword">if</span> __name__ == <span class="string">'__main__'</span>:
    port = <span class="type">int</span>(os.environ.<span class="function">get</span>(<span class="string">'PORT'</span>, <span class="string">5000</span>))
    app.<span class="function">run</span>(host=<span class="string">'0.0.0.0'</span>, port=port)</code></pre>
        </div>
        <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto mt-4">
          <pre><code><span class="comment"># requirements.txt</span>
flask==3.0.0
gunicorn==21.2.0</code></pre>
        </div>
      </div>
      
      <!-- Node.js App -->
      <div class="lang-content hidden" id="lang-node-app">
        <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
          <pre><code><span class="comment">// server.js</span>
<span class="keyword">const</span> express = <span class="function">require</span>(<span class="string">'express'</span>);
<span class="keyword">const</span> app = <span class="function">express</span>();

app.<span class="function">get</span>(<span class="string">'/'</span>, (req, res) => {lb}
    res.<span class="function">send</span>(<span class="string">'Hello from Docker! 🐳'</span>);
{rb});

app.<span class="function">get</span>(<span class="string">'/health'</span>, (req, res) => {lb}
    res.<span class="function">json</span>({lb} status: <span class="string">'healthy'</span> {rb});
{rb});

<span class="keyword">const</span> PORT = process.env.PORT || <span class="string">3000</span>;
app.<span class="function">listen</span>(PORT, () => {lb}
    console.<span class="function">log</span>(<span class="string">`Server running on port $</span>{lb}PORT{rb}<span class="string">`</span>);
{rb});</code></pre>
