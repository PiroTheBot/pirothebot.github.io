---
import LearningLayout from '../../../layouts/LearningLayout.astro';
import BulletList from '../../../components/BulletList.astro';

const lb = '{';
const rb = '}';
---

<LearningLayout 
  title="Monitoring & Observability"
  description="Build visibility into your systems — metrics, logs, traces, and alerting for production confidence"
  category="DevOps"
  categoryHref="/learning/devops"
  difficulty="Intermediate"
  readTime="16 min read"
>

<!-- Section 1: The Hook -->
<section class="mb-12 md:mb-20 fade-in">
  <div class="bg-bg-card border border-border-subtle rounded-xl p-5 md:p-8 text-center">
    <p class="text-xl md:text-2xl font-medium text-text-secondary mb-2">Think of it as the</p>
    <p class="text-3xl md:text-4xl font-bold text-primary mb-4">Nervous System</p>
    <p class="text-text-secondary text-sm md:text-base">of your infrastructure — sensing, reporting, and alerting</p>
  </div>
</section>

<!-- Section 2: Hospital Analogy -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Hospital Analogy</h2>
  
  <div class="bg-bg-card border border-border-subtle rounded-xl p-6 md:p-8 fade-in">
    <p class="text-text-secondary text-sm md:text-base mb-6 md:mb-8">
      Imagine your application is a patient in a hospital. Doctors don't just guess what's wrong — they use 
      <span class="text-primary font-medium">monitoring equipment</span> to understand the patient's health 
      in real-time and historically. The same applies to your systems.
    </p>
    
    <!-- Hospital Monitoring SVG -->
    <div class="relative overflow-x-auto" id="hospital-scene">
      <svg viewBox="0 0 600 220" class="w-full h-auto min-w-[480px]">
        <!-- Heart Monitor = Metrics -->
        <g class="equipment" id="heart-monitor">
          <rect x="20" y="30" width="160" height="110" rx="8" fill="#1a1a1a" stroke="#ef4444" stroke-width="2"/>
          <text x="100" y="55" text-anchor="middle" fill="#ef4444" font-size="12" font-weight="600">HEART MONITOR</text>
          <!-- ECG Line -->
          <polyline points="35,90 55,90 60,70 65,110 70,90 90,90 95,75 100,105 105,90 145,90" 
                    fill="none" stroke="#ef4444" stroke-width="2" class="pulse-line"/>
          <text x="100" y="125" text-anchor="middle" fill="#888" font-size="10">72 BPM • 120/80</text>
          <text x="100" y="155" text-anchor="middle" fill="#00FF88" font-size="11" font-weight="500">= METRICS</text>
          <text x="100" y="172" text-anchor="middle" fill="#666" font-size="9">Numbers over time</text>
        </g>
        
        <!-- Patient Chart = Logs -->
        <g class="equipment" id="patient-chart">
          <rect x="220" y="30" width="160" height="110" rx="8" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2"/>
          <text x="300" y="55" text-anchor="middle" fill="#3b82f6" font-size="12" font-weight="600">PATIENT CHART</text>
          <!-- Log lines -->
          <line x1="235" y1="72" x2="365" y2="72" stroke="#3b82f6" stroke-width="1" opacity="0.3"/>
          <line x1="235" y1="88" x2="365" y2="88" stroke="#3b82f6" stroke-width="1" opacity="0.3"/>
          <line x1="235" y1="104" x2="365" y2="104" stroke="#3b82f6" stroke-width="1" opacity="0.3"/>
          <line x1="235" y1="120" x2="365" y2="120" stroke="#3b82f6" stroke-width="1" opacity="0.3"/>
          <text x="240" y="82" fill="#666" font-size="8">09:00 - Patient admitted</text>
          <text x="240" y="98" fill="#666" font-size="8">09:15 - Vitals checked</text>
          <text x="240" y="114" fill="#fbbf24" font-size="8">09:30 - Fever detected</text>
          <text x="300" y="155" text-anchor="middle" fill="#3b82f6" font-size="11" font-weight="500">= LOGS</text>
          <text x="300" y="172" text-anchor="middle" fill="#666" font-size="9">Events with context</text>
        </g>
        
        <!-- Diagnostic Tests = Traces -->
        <g class="equipment" id="diagnostics">
          <rect x="420" y="30" width="160" height="110" rx="8" fill="#1a1a1a" stroke="#a78bfa" stroke-width="2"/>
          <text x="500" y="55" text-anchor="middle" fill="#a78bfa" font-size="12" font-weight="600">DIAGNOSTIC PATH</text>
          <!-- Trace visualization -->
          <rect x="435" y="70" width="130" height="12" rx="2" fill="#a78bfa" opacity="0.3"/>
          <rect x="435" y="70" width="90" height="12" rx="2" fill="#a78bfa" opacity="0.6"/>
          <text x="480" y="79" fill="#fff" font-size="7">Request</text>
          <rect x="450" y="88" width="100" height="10" rx="2" fill="#00FF88" opacity="0.3"/>
          <rect x="450" y="88" width="60" height="10" rx="2" fill="#00FF88" opacity="0.6"/>
          <text x="480" y="96" fill="#fff" font-size="6">→ Service A</text>
          <rect x="465" y="102" width="80" height="10" rx="2" fill="#fbbf24" opacity="0.3"/>
          <rect x="465" y="102" width="45" height="10" rx="2" fill="#fbbf24" opacity="0.6"/>
          <text x="495" y="110" fill="#fff" font-size="6">→ Database</text>
          <text x="500" y="155" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="500">= TRACES</text>
          <text x="500" y="172" text-anchor="middle" fill="#666" font-size="9">Request journey</text>
        </g>
        
        <!-- Patient (Your App) -->
        <text x="300" y="205" text-anchor="middle" fill="#888" font-size="11">🏥 Your Application = The Patient</text>
      </svg>
    </div>
    
    <div class="mt-8 grid md:grid-cols-3 gap-4 stagger-children">
      <div class="text-center p-4 rounded-lg bg-bg-main border border-red-500/30">
        <div class="text-3xl mb-2">💓</div>
        <p class="text-sm font-medium text-red-400">Metrics</p>
        <p class="text-xs text-text-muted mt-1">Vital signs — CPU, memory, requests/sec</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-blue-500/30">
        <div class="text-3xl mb-2">📋</div>
        <p class="text-sm font-medium text-blue-400">Logs</p>
        <p class="text-xs text-text-muted mt-1">Medical history — what happened & when</p>
      </div>
      <div class="text-center p-4 rounded-lg bg-bg-main border border-purple-400/30">
        <div class="text-3xl mb-2">🔬</div>
        <p class="text-sm font-medium text-purple-400">Traces</p>
        <p class="text-xs text-text-muted mt-1">Diagnostic path — how requests flow</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: Before/After -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Problem It Solves</h2>
  
  <div class="grid md:grid-cols-2 gap-6">
    <!-- Without Monitoring -->
    <div class="bg-bg-card border border-red-500/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-red-500 text-lg">✗</span>
        <span class="font-medium text-red-400">Flying Blind</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre class="text-text-muted"><code><span class="comment"># 3 AM on-call experience...</span>
User: "Site is slow"
You: "Let me SSH into servers..."
You: *checks 15 servers manually*
You: "Hmm, disk looks okay..."
You: *restarts random services*
You: "Try now?"
User: "Still broken"
You: 😭 *4 hours later*</code></pre>
      </div>
      <BulletList color="red" items={[
        "No idea what's happening in production",
        "Users report problems before you know",
        "Debugging is guesswork and SSH",
        "Can't answer 'why is it slow?'",
        "No historical data for comparison"
      ]} />
    </div>
    
    <!-- With Monitoring -->
    <div class="bg-bg-card border border-primary/30 rounded-xl p-6 fade-in flex flex-col">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-primary text-lg">✓</span>
        <span class="font-medium text-primary">Full Observability</span>
      </div>
      <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto flex-1 mb-4">
        <pre><code><span class="comment"># 3 AM with observability...</span>
<span class="string">[Alert]</span> <span class="type">P99 latency</span> > 500ms
<span class="string">[Dashboard]</span> Spike at 02:47
<span class="string">[Trace]</span> Slow query in <span class="function">user-service</span>
<span class="string">[Logs]</span> "Connection pool exhausted"
<span class="keyword">Fix:</span> Scale connection pool
<span class="string">[Resolved]</span> in 8 minutes ✓

<span class="comment"># Back to sleep 😴</span></code></pre>
      </div>
      <BulletList color="primary" items={[
        "Real-time visibility into all systems",
        "Alerts before users notice problems",
        "Trace exact cause of issues",
        "Historical trends for capacity planning",
        "Data-driven decisions, not guesswork"
      ]} />
    </div>
  </div>
</section>

<!-- Section 4: Three Pillars -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">The Three Pillars of Observability</h2>
  
  <div class="grid md:grid-cols-3 gap-6 stagger-children">
    <!-- Metrics -->
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6 hover:border-red-500/40 transition-colors">
      <div class="w-14 h-14 bg-red-500/10 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-red-400 mb-2">Metrics</h3>
      <p class="text-text-secondary text-sm mb-4">
        Numeric measurements over time. The vital signs of your system.
      </p>
      <div class="text-xs text-text-muted space-y-1">
        <p>• CPU utilization: 45%</p>
        <p>• Requests/second: 1,234</p>
        <p>• Error rate: 0.01%</p>
        <p>• P99 latency: 120ms</p>
      </div>
      <div class="mt-4 pt-4 border-t border-border-subtle">
        <p class="text-xs text-text-muted"><span class="text-red-400 font-medium">Best for:</span> Dashboards, alerts, trends</p>
      </div>
    </div>
    
    <!-- Logs -->
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6 hover:border-blue-500/40 transition-colors">
      <div class="w-14 h-14 bg-blue-500/10 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-blue-400 mb-2">Logs</h3>
      <p class="text-text-secondary text-sm mb-4">
        Timestamped records of discrete events. The story of what happened.
      </p>
      <div class="text-xs text-text-muted space-y-1 font-mono">
        <p class="truncate">2024-01-15 09:23:45 INFO User login</p>
        <p class="truncate">2024-01-15 09:23:46 WARN Slow query</p>
        <p class="truncate">2024-01-15 09:23:47 ERROR Timeout</p>
      </div>
      <div class="mt-4 pt-4 border-t border-border-subtle">
        <p class="text-xs text-text-muted"><span class="text-blue-400 font-medium">Best for:</span> Debugging, audit trails, search</p>
      </div>
    </div>
    
    <!-- Traces -->
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6 hover:border-purple-400/40 transition-colors">
      <div class="w-14 h-14 bg-purple-500/10 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-purple-400 mb-2">Traces</h3>
      <p class="text-text-secondary text-sm mb-4">
        End-to-end request paths across services. The journey of a request.
      </p>
      <div class="text-xs space-y-1">
        <div class="flex items-center gap-2">
          <div class="w-16 h-2 bg-purple-400/60 rounded"></div>
          <span class="text-text-muted">API Gateway 12ms</span>
        </div>
        <div class="flex items-center gap-2 pl-2">
          <div class="w-12 h-2 bg-primary/60 rounded"></div>
          <span class="text-text-muted">Auth 8ms</span>
        </div>
        <div class="flex items-center gap-2 pl-4">
          <div class="w-20 h-2 bg-yellow-400/60 rounded"></div>
          <span class="text-text-muted">DB Query 45ms</span>
        </div>
      </div>
      <div class="mt-4 pt-4 border-t border-border-subtle">
        <p class="text-xs text-text-muted"><span class="text-purple-400 font-medium">Best for:</span> Latency analysis, dependencies</p>
      </div>
    </div>
  </div>
</section>

<!-- Section 5: Prometheus + Grafana -->
<section class="mb-12 md:mb-20">
  <h2 class="text-xl font-semibold mb-6 text-white fade-in">Prometheus + Grafana</h2>
  
  <div class="bg-bg-card border border-border-subtle rounded-xl p-6 md:p-8 fade-in mb-6">
    <p class="text-text-secondary text-sm md:text-base mb-6">
      <span class="text-primary font-medium">Prometheus</span> collects and stores metrics. 
      <span class="text-primary font-medium">Grafana</span> visualizes them beautifully. 
      Together, they're the industry standard for open-source metrics.
    </p>
    
    <!-- Architecture SVG -->
    <div class="relative overflow-x-auto mb-6">
      <svg viewBox="0 0 600 200" class="w-full h-auto min-w-[480px]">
        <!-- Applications -->
        <g>
          <rect x="10" y="60" width="100" height="80" rx="8" fill="#1a1a1a" stroke="#525252" stroke-width="1.5"/>
          <text x="60" y="90" text-anchor="middle" fill="#888" font-size="11" font-weight="500">Applications</text>
          <text x="60" y="108" text-anchor="middle" fill="#666" font-size="9">/metrics</text>
          <text x="60" y="125" text-anchor="middle" fill="#00FF88" font-size="9">:8080, :9090</text>
        </g>
        
        <!-- Exporters -->
        <g>
          <rect x="10" y="150" width="100" height="40" rx="6" fill="#1a1a1a" stroke="#525252" stroke-width="1"/>
          <text x="60" y="175" text-anchor="middle" fill="#666" font-size="9">node_exporter</text>
        </g>
        
        <!-- Prometheus -->
        <g>
          <rect x="170" y="45" width="140" height="110" rx="8" fill="#1a1a1a" stroke="#e6522c" stroke-width="2"/>
          <text x="240" y="75" text-anchor="middle" fill="#e6522c" font-size="13" font-weight="600">PROMETHEUS</text>
          <text x="240" y="95" text-anchor="middle" fill="#666" font-size="9">Time-series DB</text>
          <text x="240" y="115" text-anchor="middle" fill="#666" font-size="9">Pull model</text>
          <text x="240" y="135" text-anchor="middle" fill="#666" font-size="9">PromQL</text>
        </g>
        
        <!-- Alertmanager -->
        <g>
          <rect x="350" y="120" width="100" height="50" rx="6" fill="#1a1a1a" stroke="#fbbf24" stroke-width="1.5"/>
          <text x="400" y="142" text-anchor="middle" fill="#fbbf24" font-size="10" font-weight="500">Alertmanager</text>
          <text x="400" y="158" text-anchor="middle" fill="#666" font-size="8">→ Slack, PD</text>
        </g>
        
        <!-- Grafana -->
        <g>
          <rect x="480" y="45" width="110" height="110" rx="8" fill="#1a1a1a" stroke="#f46800" stroke-width="2"/>
          <text x="535" y="75" text-anchor="middle" fill="#f46800" font-size="13" font-weight="600">GRAFANA</text>
          <text x="535" y="95" text-anchor="middle" fill="#666" font-size="9">Dashboards</text>
          <text x="535" y="115" text-anchor="middle" fill="#666" font-size="9">Visualization</text>
          <text x="535" y="135" text-anchor="middle" fill="#666" font-size="9">Alerting</text>
        </g>
        
        <!-- Arrows -->
        <path d="M115 100 L165 100" stroke="#525252" stroke-width="1.5" fill="none" marker-end="url(#arrow)"/>
        <text x="140" y="93" text-anchor="middle" fill="#666" font-size="8">scrape</text>
        
        <path d="M115 170 L165 120" stroke="#525252" stroke-width="1" stroke-dasharray="3 2" fill="none"/>
        
        <path d="M315 100 L475 100" stroke="#e6522c" stroke-width="1.5" fill="none" marker-end="url(#arrow)"/>
        <text x="395" y="93" text-anchor="middle" fill="#666" font-size="8">query</text>
        
        <path d="M315 130 L345 145" stroke="#fbbf24" stroke-width="1.5" fill="none" marker-end="url(#arrow)"/>
        <text x="320" y="150" fill="#666" font-size="8">alerts</text>
        
        <!-- Arrow marker definition -->
        <defs>
          <marker id="arrow" markerWidth="8" markerHeight="8" refX="8" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8" fill="none" stroke="currentColor" stroke-width="1"/>
          </marker>
        </defs>
      </svg>
    </div>
    
    <div class="grid md:grid-cols-3 gap-4 mb-6">
      <div class="text-center p-3 rounded-lg bg-bg-main border border-border-subtle">
        <p class="text-sm font-medium text-[#e6522c]">Pull-based</p>
        <p class="text-xs text-text-muted mt-1">Prometheus scrapes your apps</p>
      </div>
      <div class="text-center p-3 rounded-lg bg-bg-main border border-border-subtle">
        <p class="text-sm font-medium text-[#e6522c]">Time-series</p>
        <p class="text-xs text-text-muted mt-1">Optimized for metrics data</p>
      </div>
      <div class="text-center p-3 rounded-lg bg-bg-main border border-border-subtle">
        <p class="text-sm font-medium text-[#f46800]">Flexible</p>
        <p class="text-xs text-text-muted mt-1">Any data source in Grafana</p>
      </div>
    </div>
  </div>
  
  <!-- prometheus.yml -->
  <div class="mb-6 fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-[#e6522c]/20 rounded-full flex items-center justify-center text-[#e6522c] font-bold text-sm">1</span>
      <h3 class="font-medium text-text-secondary">prometheus.yml Configuration</h3>
    </div>
    <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
      <pre><code><span class="comment"># prometheus.yml</span>
<span class="type">global</span>:
  <span class="type">scrape_interval</span>: <span class="string">15s</span>       <span class="comment"># How often to scrape</span>
  <span class="type">evaluation_interval</span>: <span class="string">15s</span>  <span class="comment"># How often to evaluate rules</span>

<span class="type">alerting</span>:
  <span class="type">alertmanagers</span>:
    - <span class="type">static_configs</span>:
        - <span class="type">targets</span>: [<span class="string">'alertmanager:9093'</span>]

<span class="type">rule_files</span>:
  - <span class="string">"alerts/*.yml"</span>

<span class="type">scrape_configs</span>:
  <span class="comment"># Prometheus itself</span>
  - <span class="type">job_name</span>: <span class="string">'prometheus'</span>
    <span class="type">static_configs</span>:
      - <span class="type">targets</span>: [<span class="string">'localhost:9090'</span>]

  <span class="comment"># Your applications</span>
  - <span class="type">job_name</span>: <span class="string">'web-app'</span>
    <span class="type">static_configs</span>:
      - <span class="type">targets</span>: [<span class="string">'app1:8080'</span>, <span class="string">'app2:8080'</span>, <span class="string">'app3:8080'</span>]

  <span class="comment"># Node exporters (host metrics)</span>
  - <span class="type">job_name</span>: <span class="string">'node'</span>
    <span class="type">static_configs</span>:
      - <span class="type">targets</span>: [<span class="string">'node1:9100'</span>, <span class="string">'node2:9100'</span>]

  <span class="comment"># Kubernetes service discovery</span>
  - <span class="type">job_name</span>: <span class="string">'kubernetes-pods'</span>
    <span class="type">kubernetes_sd_configs</span>:
      - <span class="type">role</span>: <span class="string">pod</span>
    <span class="type">relabel_configs</span>:
      - <span class="type">source_labels</span>: [<span class="type">__meta_kubernetes_pod_annotation_prometheus_io_scrape</span>]
        <span class="type">action</span>: <span class="string">keep</span>
        <span class="type">regex</span>: <span class="string">true</span></code></pre>
    </div>
  </div>
  
  <!-- PromQL Examples -->
  <div class="fade-in">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-8 bg-[#e6522c]/20 rounded-full flex items-center justify-center text-[#e6522c] font-bold text-sm">2</span>
      <h3 class="font-medium text-text-secondary">PromQL Query Examples</h3>
    </div>
    <div class="bg-bg-card border border-border-subtle rounded-xl p-6">
      <div class="space-y-4">
        <div>
          <p class="text-text-muted text-xs mb-2">Request rate (per second)</p>
          <div class="bg-bg-code rounded-lg p-3 text-xs sm:text-sm overflow-x-auto">
            <code><span class="function">rate</span>(<span class="type">http_requests_total</span>[<span class="string">5m</span>])</code>
          </div>
        </div>
        <div>
          <p class="text-text-muted text-xs mb-2">Error rate percentage</p>
          <div class="bg-bg-code rounded-lg p-3 text-xs sm:text-sm overflow-x-auto">
            <code><span class="function">sum</span>(<span class="function">rate</span>(<span class="type">http_requests_total</span>{lb}<span class="type">status</span>=~<span class="string">"5.."</span>{rb}[<span class="string">5m</span>])) / <span class="function">sum</span>(<span class="function">rate</span>(<span class="type">http_requests_total</span>[<span class="string">5m</span>])) * <span class="string">100</span></code>
          </div>
        </div>
        <div>
          <p class="text-text-muted text-xs mb-2">P95 latency (histogram)</p>
          <div class="bg-bg-code rounded-lg p-3 text-xs sm:text-sm overflow-x-auto">
