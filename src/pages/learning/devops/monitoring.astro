            <p class="text-sm font-medium text-orange-400">P2 - High</p>
            <p class="text-xs text-text-muted">Degraded service. Needs attention within an hour.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-yellow-500/10 border border-yellow-500/30">
          <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
          <div>
            <p class="text-sm font-medium text-yellow-400">P3 - Medium</p>
            <p class="text-xs text-text-muted">Not urgent. Handle during business hours.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-blue-500/10 border border-blue-500/30">
          <span class="w-3 h-3 rounded-full bg-blue-500"></span>
          <div>
            <p class="text-sm font-medium text-blue-400">P4 - Low</p>
            <p class="text-xs text-text-muted">Informational. Review when time permits.</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Alert Fatigue -->
    <div class="bg-bg-card border border-yellow-500/30 rounded-xl p-6 fade-in">
      <div class="flex items-start gap-4 mb-4">
        <div class="w-10 h-10 bg-yellow-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-xl">⚠️</span>
        </div>
        <div>
          <h3 class="font-medium text-yellow-400">Avoiding Alert Fatigue</h3>
          <p class="text-text-muted text-sm mt-1">
            Too many alerts = ignored alerts. Be ruthless.
          </p>
        </div>
      </div>
      <BulletList color="yellow" items={[
        "Every alert must be actionable",
        "If you ignore it 3 times, delete it",
        "Group related alerts together",
        "Set reasonable thresholds (not too sensitive)",
        "Use escalation policies, not spam",
        "Review and prune alerts quarterly"
      ]} />
    </div>
  </div>
  
  <!-- Alert Rules Example -->
  <div class="bg-bg-card border border-border-subtle rounded-xl p-6 fade-in">
    <h4 class="font-medium text-text-secondary mb-4">Prometheus Alert Rules Example</h4>
    <div class="bg-bg-code rounded-lg p-3 md:p-4 text-xs sm:text-sm overflow-x-auto">
      <pre><code><span class="comment"># alerts/app_alerts.yml</span>
<span class="type">groups</span>:
  - <span class="type">name</span>: <span class="string">app_alerts</span>
    <span class="type">rules</span>:
      <span class="comment"># High error rate</span>
      - <span class="type">alert</span>: <span class="string">HighErrorRate</span>
        <span class="type">expr</span>: |
          <span class="function">sum</span>(<span class="function">rate</span>(<span class="type">http_requests_total</span>{lb}<span class="type">status</span>=~<span class="string">"5.."</span>{rb}[<span class="string">5m</span>])) /
          <span class="function">sum</span>(<span class="function">rate</span>(<span class="type">http_requests_total</span>[<span class="string">5m</span>])) > <span class="string">0.05</span>
        <span class="type">for</span>: <span class="string">5m</span>
        <span class="type">labels</span>:
          <span class="type">severity</span>: <span class="string">critical</span>
        <span class="type">annotations</span>:
          <span class="type">summary</span>: <span class="string">"High error rate detected"</span>
          <span class="type">description</span>: <span class="string">"Error rate is {lb}{lb} $value | humanizePercentage {rb}{rb}"</span>

      <span class="comment"># Slow response times</span>
      - <span class="type">alert</span>: <span class="string">HighLatency</span>
        <span class="type">expr</span>: |
          <span class="function">histogram_quantile</span>(<span class="string">0.95</span>,
            <span class="function">rate</span>(<span class="type">http_request_duration_seconds_bucket</span>[<span class="string">5m</span>])
          ) > <span class="string">0.5</span>
        <span class="type">for</span>: <span class="string">10m</span>
        <span class="type">labels</span>:
          <span class="type">severity</span>: <span class="string">warning</span>
        <span class="type">annotations</span>:
          <span class="type">summary</span>: <span class="string">"High P95 latency"</span>
          <span class="type">description</span>: <span class="string">"P95 latency is {lb}{lb} $value | humanizeDuration {rb}{rb}"</span>

      <span class="comment"># Instance down</span>
      - <span class="type">alert</span>: <span class="string">InstanceDown</span>
        <span class="type">expr</span>: <span class="function">up</span> == <span class="string">0</span>
        <span class="type">for</span>: <span class="string">1m</span>
        <span class="type">labels</span>:
          <span class="type">severity</span>: <span class="string">critical</span>
        <span class="type">annotations</span>:
          <span class="type">summary</span>: <span class="string">"Instance {lb}{lb} $labels.instance {rb}{rb} down"</span></code></pre>
    </div>
  </div>
</section>

