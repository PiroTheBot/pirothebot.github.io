          <pre><code><span class="comment">// app.js</span>
<span class="keyword">const</span> express = <span class="function">require</span>(<span class="string">'express'</span>);
<span class="keyword">const</span> client = <span class="function">require</span>(<span class="string">'prom-client'</span>);

<span class="keyword">const</span> app = <span class="function">express</span>();

<span class="comment">// Enable default metrics (CPU, memory, etc.)</span>
client.<span class="function">collectDefaultMetrics</span>();

<span class="comment">// Custom metrics</span>
<span class="keyword">const</span> httpRequestsTotal = <span class="keyword">new</span> client.<span class="type">Counter</span>({lb}
  <span class="type">name</span>: <span class="string">'http_requests_total'</span>,
  <span class="type">help</span>: <span class="string">'Total HTTP requests'</span>,
  <span class="type">labelNames</span>: [<span class="string">'method'</span>, <span class="string">'route'</span>, <span class="string">'status'</span>]
{rb});

<span class="keyword">const</span> httpRequestDuration = <span class="keyword">new</span> client.<span class="type">Histogram</span>({lb}
  <span class="type">name</span>: <span class="string">'http_request_duration_seconds'</span>,
  <span class="type">help</span>: <span class="string">'HTTP request latency in seconds'</span>,
  <span class="type">labelNames</span>: [<span class="string">'method'</span>, <span class="string">'route'</span>],
  <span class="type">buckets</span>: [<span class="string">0.005</span>, <span class="string">0.01</span>, <span class="string">0.025</span>, <span class="string">0.05</span>, <span class="string">0.1</span>, <span class="string">0.25</span>, <span class="string">0.5</span>, <span class="string">1</span>, <span class="string">2.5</span>, <span class="string">5</span>]
{rb});

<span class="comment">// Middleware to track requests</span>
app.<span class="function">use</span>((req, res, next) => {lb}
  <span class="keyword">const</span> end = httpRequestDuration.<span class="function">startTimer</span>({lb}
    <span class="type">method</span>: req.method,
    <span class="type">route</span>: req.route?.path || req.path
  {rb});
  
  res.<span class="function">on</span>(<span class="string">'finish'</span>, () => {lb}
    httpRequestsTotal.<span class="function">inc</span>({lb}
      <span class="type">method</span>: req.method,
      <span class="type">route</span>: req.route?.path || req.path,
      <span class="type">status</span>: res.statusCode
    {rb});
    <span class="function">end</span>();
  {rb});
  
  <span class="function">next</span>();
{rb});

<span class="comment">// Metrics endpoint</span>
app.<span class="function">get</span>(<span class="string">'/metrics'</span>, <span class="keyword">async</span> (req, res) => {lb}
  res.<span class="function">set</span>(<span class="string">'Content-Type'</span>, client.register.contentType);
  res.<span class="function">send</span>(<span class="keyword">await</span> client.register.<span class="function">metrics</span>());
{rb});</code></pre>
