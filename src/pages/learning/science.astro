---
import '../../styles/global.css'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Science — Learning Corner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-bg-dark text-text-primary min-h-screen flex flex-col">
  <!-- Nav -->
  <nav class="border-b border-border-subtle py-4">
    <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
      <a href="/learning" class="text-text-secondary hover:text-white transition-colors text-sm font-medium flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Learning Corner
      </a>
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 bg-primary rounded-full"></span>
        <span class="text-text-secondary text-sm">Science</span>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="py-16 px-6 border-b border-border-subtle">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-3 tracking-tight">Science</h1>
      <p class="text-text-secondary text-lg">Physics, quantum mechanics, and the science behind technology.</p>
    </div>
  </section>

  <!-- Topics -->
  <section class="py-12 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-6">Available Topics</h2>
      
      <div class="space-y-4">
        <!-- Quantum Computing -->
        <a href="/learning/science/quantum-computing" class="group block bg-bg-card border border-border-subtle rounded-xl p-6 transition-all duration-300 hover:bg-bg-hover hover:border-primary/40">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded">Beginner</span>
                <span class="text-text-muted text-sm">28 min read</span>
              </div>
              <h3 class="text-lg font-semibold text-white group-hover:text-primary transition-colors">Quantum Computing</h3>
              <p class="text-text-muted text-sm mt-1">From Schrödinger's cat to quantum supremacy — understand the computers that could change everything</p>
            </div>
            <div class="ml-4">
              <svg class="w-5 h-5 text-text-muted group-hover:text-primary transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      </div>

      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-6 mt-12">Coming Soon</h2>
      
      <div class="space-y-4">
        <div class="bg-bg-card border border-border-subtle rounded-xl p-6 opacity-50">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-medium text-text-muted bg-bg-hover px-2 py-1 rounded">Coming</span>
              </div>
              <h3 class="text-lg font-semibold text-white">Relativity</h3>
              <p class="text-text-muted text-sm mt-1">Einstein's special and general relativity — spacetime, gravity, and the fabric of the universe</p>
            </div>
          </div>
        </div>

        <div class="bg-bg-card border border-border-subtle rounded-xl p-6 opacity-50">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-medium text-text-muted bg-bg-hover px-2 py-1 rounded">Coming</span>
              </div>
              <h3 class="text-lg font-semibold text-white">Particle Physics</h3>
              <p class="text-text-muted text-sm mt-1">The Standard Model — quarks, leptons, bosons, and the fundamental building blocks of matter</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-12 px-6 border-t border-border-subtle mt-auto">
    <div class="max-w-6xl mx-auto text-center">
      <a href="/learning" class="inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Learning Corner
      </a>
    </div>
  </footer>
</body>
</html>
