<!-- Section 27: Key Takeaways -->
<section class="mb-12 md:mb-20 fade-in">
  <h2 class="text-xl font-semibold mb-6 text-white">Key Takeaways</h2>

  <div class="grid md:grid-cols-2 gap-4">
    <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
      <div class="flex items-start gap-3">
        <span class="text-primary font-bold text-lg">1</span>
        <p class="text-text-secondary text-sm">Qubits use <strong class="text-white">superposition</strong> — a linear combination of |0⟩ and |1⟩ with complex amplitudes, not "both at once."</p>
      </div>
    </div>

    <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
      <div class="flex items-start gap-3">
        <span class="text-primary font-bold text-lg">2</span>
        <p class="text-text-secondary text-sm"><strong class="text-white">Entanglement</strong> creates correlations between qubits — but doesn't allow faster-than-light communication.</p>
      </div>
    </div>

    <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
      <div class="flex items-start gap-3">
        <span class="text-primary font-bold text-lg">3</span>
        <p class="text-text-secondary text-sm"><strong class="text-white">Interference</strong> is the secret sauce — amplifying correct answers and canceling wrong ones.</p>
      </div>
    </div>

