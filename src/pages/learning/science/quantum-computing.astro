      <pre class="text-xs sm:text-sm font-mono"><span class="text-comment"># Create an entangled Bell state: (|00⟩ + |11⟩) / √2</span>
<span class="text-keyword">from</span> <span class="text-type">qiskit</span> <span class="text-keyword">import</span> QuantumCircuit
<span class="text-keyword">from</span> <span class="text-type">qiskit_aer</span> <span class="text-keyword">import</span> AerSimulator

<span class="text-comment"># Build the circuit</span>
