        <text x="122" y="20" text-anchor="middle" fill="#525252" font-size="9">Step 1: Superposition</text>
        <text x="250" y="20" text-anchor="middle" fill="#525252" font-size="9">Step 2: Ask once</text>
        <text x="382" y="20" text-anchor="middle" fill="#525252" font-size="9">Step 3: Interference</text>
        <text x="480" y="20" text-anchor="middle" fill="#525252" font-size="9">Step 4: Read</text>

