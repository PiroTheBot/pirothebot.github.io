qc.h(<span class="text-string">0</span>)          <span class="text-comment"># Hadamard on qubit 0 → superposition</span>
qc.cx(<span class="text-string">0</span>, <span class="text-string">1</span>)      <span class="text-comment"># CNOT: qubit 0 controls qubit 1 → entanglement</span>
qc.measure([<span class="text-string">0</span>, <span class="text-string">1</span>], [<span class="text-string">0</span>, <span class="text-string">1</span>])  <span class="text-comment"># Measure both</span>

<span class="text-comment"># Run on simulator</span>
simulator = AerSimulator()
result = simulator.run(qc, shots=<span class="text-string">1000</span>).result()
counts = result.get_counts()

<span class="text-function">print</span>(counts)
<span class="text-comment"># Output: ${lb}'00': ~500, '11': ~500${rb}</span>
<span class="text-comment"># Always correlated! Never '01' or '10'.</span>
<span class="text-comment"># That's entanglement in action.</span></pre>
    </div>
