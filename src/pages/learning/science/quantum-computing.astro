      <text x="310" y="60" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="600">2001</text>
      <text x="310" y="110" text-anchor="middle" fill="#A3A3A3" font-size="9">IBM factors</text>
      <text x="310" y="122" text-anchor="middle" fill="#525252" font-size="8">15 = 3 × 5</text>

