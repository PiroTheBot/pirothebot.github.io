        <!-- After 1 iteration -->
        <text x="240" y="45" text-anchor="middle" fill="#525252" font-size="10">After 1 iteration</text>
        <rect x="200" y="130" width="20" height="30" rx="2" fill="#00FF88" opacity="0.3"/>
        <rect x="225" y="130" width="20" height="30" rx="2" fill="#00FF88" opacity="0.3"/>
        <rect x="250" y="55" width="20" height="105" rx="2" fill="#00FF88" opacity="0.8"/>
        <rect x="275" y="130" width="20" height="30" rx="2" fill="#00FF88" opacity="0.3"/>
        <line x1="195" y1="160" x2="300" y2="160" stroke="#404040" stroke-width="1"/>

        <!-- Arrow -->
        <text x="160" y="105" fill="#A3A3A3" font-size="16">→</text>
        <text x="320" y="105" fill="#A3A3A3" font-size="16">→</text>

        <!-- Final -->
        <text x="420" y="45" text-anchor="middle" fill="#525252" font-size="10">Optimal iterations</text>
        <rect x="375" y="148" width="20" height="12" rx="2" fill="#00FF88" opacity="0.1"/>
        <rect x="400" y="148" width="20" height="12" rx="2" fill="#00FF88" opacity="0.1"/>
