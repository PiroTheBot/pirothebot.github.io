      <circle cx="420" cy="80" r="6" fill="#f472b6"/>
      <text x="420" y="60" text-anchor="middle" fill="#f472b6" font-size="11" font-weight="600">2019</text>
      <text x="420" y="110" text-anchor="middle" fill="#A3A3A3" font-size="9">Google</text>
      <text x="420" y="122" text-anchor="middle" fill="#525252" font-size="8">"Supremacy"</text>

      <!-- 2023 IBM 1000+ -->
      <circle cx="510" cy="80" r="6" fill="#22d3ee"/>
      <text x="510" y="60" text-anchor="middle" fill="#22d3ee" font-size="11" font-weight="600">2023</text>
      <text x="510" y="110" text-anchor="middle" fill="#A3A3A3" font-size="9">IBM 1,121</text>
      <text x="510" y="122" text-anchor="middle" fill="#525252" font-size="8">qubits</text>

      <!-- 2024 NIST PQC -->
      <circle cx="555" cy="80" r="6" fill="#34d399"/>
      <text x="555" y="60" text-anchor="middle" fill="#34d399" font-size="11" font-weight="600">2024</text>
      <text x="555" y="110" text-anchor="middle" fill="#A3A3A3" font-size="9">NIST PQC</text>
