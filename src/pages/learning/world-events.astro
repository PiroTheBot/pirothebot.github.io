---
import '../../styles/global.css'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>World Events — Learning Corner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-bg-dark text-text-primary min-h-screen flex flex-col">
  <!-- Nav -->
  <nav class="border-b border-border-subtle py-4">
    <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
      <a href="/learning" class="text-text-secondary hover:text-white transition-colors text-sm font-medium flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Learning Corner
      </a>
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 bg-primary rounded-full"></span>
        <span class="text-text-secondary text-sm">World Events</span>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="py-16 px-6 border-b border-border-subtle">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-3 tracking-tight">World Events</h1>
      <p class="text-text-secondary text-lg">Geopolitics, conflicts, and global affairs — explained clearly with timelines and context.</p>
    </div>
  </section>

  <!-- Topics -->
  <section class="py-12 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-sm font-medium text-text-muted uppercase tracking-wider mb-6">Available Topics</h2>
      
      <div class="rounded-xl border border-border-subtle bg-bg-card p-6">
        <p class="text-sm text-text-muted">No public world events topics are being shown right now.</p>
      </div>
    </div>
  </section>

  <footer class="py-12 px-6 border-t border-border-subtle mt-auto">
    <div class="max-w-6xl mx-auto text-center">
      <a href="/learning" class="inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Learning Corner
      </a>
    </div>
  </footer>
</body>
</html>
