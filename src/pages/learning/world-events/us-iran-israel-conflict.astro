---
import LearningLayout from '../../../layouts/LearningLayout.astro';
import BulletList from '../../../components/BulletList.astro';

const lb = '{';
const rb = '}';
---

<LearningLayout 
  title="The US, Iran & Israel Conflict Explained"
  description="From the 1953 CIA coup to Operation Epic Fury and the 25 April 2026 Pakistan talks crisis, the full timeline of how the US, Iran, and Israel ended up at war."
  category="World Events"
  categoryHref="/learning/world-events"
  difficulty="Intermediate"
  readTime="15 min read"
>

  <!-- Hook -->
  <section class="mb-12 md:mb-20 fade-in">
    <div class="bg-bg-card border border-border-subtle rounded-xl p-5 md:p-8 text-center">
      <p class="text-xl md:text-2xl font-medium text-text-secondary mb-2">Think of it as a</p>
      <p class="text-3xl md:text-4xl font-bold text-primary mb-4">70-Year Grudge Match</p>
      <p class="text-text-secondary text-sm md:text-base">Three nations, seven decades of coups, revolutions, proxies, and broken deals — that just went hot.</p>
    </div>
  </section>

  <!-- The Key Players -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">The Key Players</h2>
    <div class="overflow-x-auto fade-in">
      <svg viewBox="0 0 600 380" class="w-full h-auto min-w-[480px]" xmlns="http://www.w3.org/2000/svg">
        <!-- Triangle of relationships -->
        <!-- US node -->
        <rect x="225" y="20" width="150" height="80" rx="12" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2"/>
        <text x="300" y="50" text-anchor="middle" fill="#3b82f6" font-size="16" font-weight="bold">🇺🇸 United States</text>
        <text x="300" y="70" text-anchor="middle" fill="#a3a3a3" font-size="10">Superpower · 13 ME bases</text>
        <text x="300" y="85" text-anchor="middle" fill="#a3a3a3" font-size="10">30-40k troops deployed</text>

        <!-- Iran node -->
        <rect x="30" y="260" width="170" height="80" rx="12" fill="#1a1a1a" stroke="#ef4444" stroke-width="2"/>
        <text x="115" y="290" text-anchor="middle" fill="#ef4444" font-size="16" font-weight="bold">🇮🇷 Iran</text>
        <text x="115" y="310" text-anchor="middle" fill="#a3a3a3" font-size="10">Islamic Republic since 1979</text>
        <text x="115" y="325" text-anchor="middle" fill="#a3a3a3" font-size="10">Nuclear ambitions · Axis of Resistance</text>

        <!-- Israel node -->
        <rect x="400" y="260" width="170" height="80" rx="12" fill="#1a1a1a" stroke="#00FF88" stroke-width="2"/>
        <text x="485" y="290" text-anchor="middle" fill="#00FF88" font-size="16" font-weight="bold">🇮🇱 Israel</text>
        <text x="485" y="310" text-anchor="middle" fill="#a3a3a3" font-size="10">US's closest ME ally</text>
        <text x="485" y="325" text-anchor="middle" fill="#a3a3a3" font-size="10">Views Iran as existential threat</text>

        <!-- US → Israel (alliance) -->
        <line x1="375" y1="100" x2="470" y2="260" stroke="#00FF88" stroke-width="2" stroke-dasharray="6,4" class="flow-path"/>
        <text x="445" y="175" text-anchor="middle" fill="#00FF88" font-size="10" transform="rotate(28, 445, 175)">Close Alliance</text>

        <!-- US → Iran (hostility) -->
        <line x1="225" y1="100" x2="130" y2="260" stroke="#ef4444" stroke-width="2" stroke-dasharray="6,4" class="flow-path"/>
        <text x="155" y="175" text-anchor="middle" fill="#ef4444" font-size="10" transform="rotate(-28, 155, 175)">No Relations Since 1980</text>

        <!-- Iran ↔ Israel (enemies) -->
        <line x1="200" y1="300" x2="400" y2="300" stroke="#fbbf24" stroke-width="2" stroke-dasharray="6,4" class="flow-path"/>
        <text x="300" y="290" text-anchor="middle" fill="#fbbf24" font-size="10">Proxy War → Direct War</text>

        <!-- Conflict pulse dots -->
        <circle cx="300" cy="300" r="4" fill="#fbbf24" class="pulse-dot"/>
        <circle cx="155" cy="180" r="4" fill="#ef4444" class="pulse-dot" style="animation-delay: 0.5s"/>
      </svg>
    </div>
  </section>

  <!-- Historical Timeline -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">Timeline — Historical Roots</h2>
    <div class="overflow-x-auto fade-in">
      <svg viewBox="0 0 600 820" class="w-full h-auto min-w-[480px]" xmlns="http://www.w3.org/2000/svg">
        <!-- Central timeline line -->
        <line x1="100" y1="30" x2="100" y2="790" stroke="#262626" stroke-width="3"/>

        <!-- 1953 -->
        <circle cx="100" cy="50" r="8" fill="#3b82f6" class="pulse-dot"/>
        <text x="120" y="45" fill="#3b82f6" font-size="14" font-weight="bold">1953</text>
        <text x="120" y="62" fill="#ffffff" font-size="11">CIA/MI6 coup overthrows PM Mosaddegh</text>
        <text x="120" y="77" fill="#a3a3a3" font-size="10">Installs Shah — Iran's democracy destroyed</text>

        <!-- 1957 -->
        <circle cx="100" cy="120" r="8" fill="#3b82f6"/>
        <text x="120" y="115" fill="#3b82f6" font-size="14" font-weight="bold">1957</text>
        <text x="120" y="132" fill="#ffffff" font-size="11">US launches Iran's nuclear program</text>
        <text x="120" y="147" fill="#a3a3a3" font-size="10">"Atoms for Peace" — the irony writes itself</text>

        <!-- 1979 -->
        <circle cx="100" cy="200" r="10" fill="#ef4444" class="pulse-dot"/>
        <text x="120" y="195" fill="#ef4444" font-size="14" font-weight="bold">1979</text>
        <text x="120" y="212" fill="#ffffff" font-size="11">Islamic Revolution — Shah overthrown</text>
        <text x="120" y="227" fill="#a3a3a3" font-size="10">US Embassy hostage crisis (444 days)</text>

        <!-- 1980 -->
        <circle cx="100" cy="275" r="8" fill="#ef4444"/>
        <text x="120" y="270" fill="#ef4444" font-size="14" font-weight="bold">1980</text>
        <text x="120" y="287" fill="#ffffff" font-size="11">US-Iran relations severed — never restored</text>
        <text x="120" y="302" fill="#a3a3a3" font-size="10">Iran-Iraq War begins (US backs Saddam)</text>

        <!-- 2002 -->
        <circle cx="100" cy="360" r="8" fill="#fbbf24"/>
        <text x="120" y="355" fill="#fbbf24" font-size="14" font-weight="bold">2002</text>
        <text x="120" y="372" fill="#ffffff" font-size="11">Iran's secret nuclear sites exposed</text>
        <text x="120" y="387" fill="#a3a3a3" font-size="10">Nuclear crisis begins</text>

        <!-- 2015 -->
        <circle cx="100" cy="440" r="8" fill="#00FF88"/>
        <text x="120" y="435" fill="#00FF88" font-size="14" font-weight="bold">2015</text>
        <text x="120" y="452" fill="#ffffff" font-size="11">JCPOA nuclear deal signed (Obama era)</text>
        <text x="120" y="467" fill="#a3a3a3" font-size="10">Iran freezes enrichment for sanctions relief</text>

        <!-- 2018 -->
        <circle cx="100" cy="520" r="8" fill="#ef4444" class="pulse-dot" style="animation-delay: 0.3s"/>
        <text x="120" y="515" fill="#ef4444" font-size="14" font-weight="bold">2018</text>
        <text x="120" y="532" fill="#ffffff" font-size="11">Trump withdraws from JCPOA</text>
        <text x="120" y="547" fill="#a3a3a3" font-size="10">"Maximum pressure" campaign begins</text>

        <!-- 2020 -->
        <circle cx="100" cy="600" r="8" fill="#ef4444"/>
        <text x="120" y="595" fill="#ef4444" font-size="14" font-weight="bold">2020</text>
        <text x="120" y="612" fill="#ffffff" font-size="11">US assassinates Gen. Qasem Soleimani</text>
        <text x="120" y="627" fill="#a3a3a3" font-size="10">Iran's top military commander killed by drone</text>

        <!-- 2023 -->
        <circle cx="100" cy="680" r="10" fill="#fbbf24" class="pulse-dot" style="animation-delay: 0.6s"/>
        <text x="120" y="675" fill="#fbbf24" font-size="14" font-weight="bold">7 October 2023</text>
        <text x="120" y="692" fill="#ffffff" font-size="11">Hamas attacks Israel → Gaza War</text>
        <text x="120" y="707" fill="#a3a3a3" font-size="10">Regional escalation spiral begins</text>

        <!-- 2025-2026 -->
        <circle cx="100" cy="760" r="10" fill="#ef4444" class="pulse-dot" style="animation-delay: 0.9s"/>
        <text x="120" y="755" fill="#ef4444" font-size="14" font-weight="bold">2025–2026</text>
        <text x="120" y="772" fill="#ffffff" font-size="11">Twelve-Day War → Operation Epic Fury</text>
        <text x="120" y="787" fill="#a3a3a3" font-size="10">Full-scale US-Israel strikes on Iran</text>
      </svg>
    </div>
  </section>

  <!-- The Proxy Web -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">The Proxy Web — Iran's "Axis of Resistance"</h2>
    <div class="overflow-x-auto fade-in">
      <svg viewBox="0 0 600 420" class="w-full h-auto min-w-[480px]" xmlns="http://www.w3.org/2000/svg">
        <!-- Iran center -->
        <rect x="225" y="10" width="150" height="60" rx="10" fill="#1a1a1a" stroke="#ef4444" stroke-width="2"/>
        <text x="300" y="35" text-anchor="middle" fill="#ef4444" font-size="14" font-weight="bold">🇮🇷 IRAN</text>
        <text x="300" y="55" text-anchor="middle" fill="#a3a3a3" font-size="10">Funds · Arms · Trains</text>

        <!-- Hezbollah -->
        <rect x="20" y="140" width="130" height="55" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="85" y="163" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold">Hezbollah</text>
        <text x="85" y="180" text-anchor="middle" fill="#a3a3a3" font-size="9">Lebanon · 100k+ rockets</text>
        <line x1="225" y1="55" x2="150" y2="140" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,3" class="flow-path"/>

        <!-- Hamas -->
        <rect x="170" y="140" width="130" height="55" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="235" y="163" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold">Hamas</text>
        <text x="235" y="180" text-anchor="middle" fill="#a3a3a3" font-size="9">Gaza · 7 October attack</text>
        <line x1="280" y1="70" x2="255" y2="140" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,3" class="flow-path"/>

        <!-- Houthis -->
        <rect x="320" y="140" width="130" height="55" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="385" y="163" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold">Houthis</text>
        <text x="385" y="180" text-anchor="middle" fill="#a3a3a3" font-size="9">Yemen · Red Sea attacks</text>
        <line x1="340" y1="70" x2="365" y2="140" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,3" class="flow-path"/>

        <!-- PMF -->
        <rect x="450" y="140" width="130" height="55" rx="8" fill="#1a1a1a" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="515" y="163" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="bold">PMF</text>
        <text x="515" y="180" text-anchor="middle" fill="#a3a3a3" font-size="9">Iraq · Militia network</text>
        <line x1="375" y1="55" x2="480" y2="140" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,3" class="flow-path"/>

        <!-- Israel fighting proxies -->
        <rect x="170" y="320" width="130" height="55" rx="10" fill="#1a1a1a" stroke="#00FF88" stroke-width="2"/>
        <text x="235" y="345" text-anchor="middle" fill="#00FF88" font-size="14" font-weight="bold">🇮🇱 ISRAEL</text>
        <text x="235" y="363" text-anchor="middle" fill="#a3a3a3" font-size="10">Fights all proxies</text>

        <!-- US backing Israel -->
        <rect x="370" y="320" width="130" height="55" rx="10" fill="#1a1a1a" stroke="#3b82f6" stroke-width="2"/>
        <text x="435" y="345" text-anchor="middle" fill="#3b82f6" font-size="14" font-weight="bold">🇺🇸 US</text>
        <text x="435" y="363" text-anchor="middle" fill="#a3a3a3" font-size="10">Backs Israel · Strikes Iran</text>

        <!-- Israel vs proxies arrows -->
        <line x1="200" y1="320" x2="85" y2="195" stroke="#00FF88" stroke-width="1.5" stroke-dasharray="4,3" class="flow-path-reverse"/>
        <line x1="235" y1="320" x2="235" y2="195" stroke="#00FF88" stroke-width="1.5" stroke-dasharray="4,3" class="flow-path-reverse"/>
        <line x1="270" y1="320" x2="385" y2="195" stroke="#00FF88" stroke-width="1.5" stroke-dasharray="4,3" class="flow-path-reverse"/>

        <!-- US-Israel alliance -->
        <line x1="300" y1="347" x2="370" y2="347" stroke="#3b82f6" stroke-width="2"/>

        <!-- Conflict indicator -->
        <text x="300" y="270" text-anchor="middle" fill="#525252" font-size="10">↕ PROXY BATTLEFIELD ↕</text>
      </svg>
    </div>
  </section>

  <!-- The Nuclear Question -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">The Nuclear Question</h2>
    <div class="grid md:grid-cols-2 gap-4 stagger-children">
      <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-yellow-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
            <span class="text-xl">☢️</span>
          </div>
          <div>
            <h3 class="font-medium text-white mb-1">Enrichment Beyond Civilian Use</h3>
            <p class="text-text-muted text-sm">Iran enriched uranium to 60% purity — weapons-grade is 90%. Far beyond the 3.67% allowed for power plants.</p>
          </div>
        </div>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
            <span class="text-xl">🤝</span>
          </div>
          <div>
            <h3 class="font-medium text-white mb-1">JCPOA Froze the Program (2015)</h3>
            <p class="text-text-muted text-sm">Iran agreed to limit enrichment in exchange for sanctions relief. It worked — until it didn't.</p>
          </div>
        </div>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-red-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
            <span class="text-xl">💥</span>
          </div>
          <div>
            <h3 class="font-medium text-white mb-1">Trump Withdrew (2018)</h3>
            <p class="text-text-muted text-sm">Pulled out of the deal, imposed "maximum pressure" sanctions. Iran responded by restarting enrichment.</p>
          </div>
        </div>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-red-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
            <span class="text-xl">🔍</span>
          </div>
          <div>
            <h3 class="font-medium text-white mb-1">IAEA Inspections Suspended</h3>
            <p class="text-text-muted text-sm">Iran kicked out inspectors. The world lost eyes on Iran's nuclear facilities. Israel calls it existential.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2023-2024 Escalation -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">2023–2024 Escalation</h2>
    <div class="space-y-6">
      <div class="mb-6 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm">1</span>
          <h3 class="font-medium text-text-secondary">7 October 2023 — Hamas attacks Israel</h3>
        </div>
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
          <p class="text-text-secondary text-sm">The deadliest attack on Israel in its history. 1,200 killed, 250 taken hostage. Israel declares war on Hamas in Gaza. The regional powder keg ignites.</p>
        </div>
      </div>
      <div class="mb-6 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm">2</span>
          <h3 class="font-medium text-text-secondary">1 April 2024 — Israel bombs Iranian consulate in Damascus</h3>
        </div>
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
          <p class="text-text-secondary text-sm">Israel strikes Iran's consulate in Syria, killing senior IRGC commanders including Gen. Mohammad Reza Zahedi. A major escalation — attacking diplomatic premises.</p>
        </div>
      </div>
      <div class="mb-6 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm">3</span>
          <h3 class="font-medium text-text-secondary">13 April 2024 — Iran's first direct strike on Israel</h3>
        </div>
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
          <p class="text-text-secondary text-sm">Iran launches 300+ drones and missiles at Israel. Most intercepted by Israel, US, UK, and Jordan. First time Iran directly attacks Israel from its own soil.</p>
        </div>
      </div>
      <div class="mb-6 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm">4</span>
          <h3 class="font-medium text-text-secondary">31 July 2024 — Haniyeh assassinated in Tehran</h3>
        </div>
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
          <p class="text-text-secondary text-sm">Israel assassinates Hamas leader Ismail Haniyeh while he's in Tehran for Iran's presidential inauguration. A humiliation for Iran on their own soil.</p>
        </div>
      </div>
      <div class="mb-6 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm">5</span>
          <h3 class="font-medium text-text-secondary">1 October 2024 — Iran's second missile barrage</h3>
        </div>
        <div class="bg-bg-card border border-border-subtle rounded-xl p-5">
          <p class="text-text-secondary text-sm">Iran launches ~200 ballistic missiles at Israel. Some get through defenses. Israel retaliates on 26 October 2024 with strikes in Iran. The tit-for-tat becomes a pattern.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Twelve-Day War -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">The Twelve-Day War — June 2025</h2>
    <div class="bg-bg-card border border-red-500/30 rounded-xl p-5 md:p-8 mb-6 fade-in">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-red-500 text-lg">⚔️</span>
        <span class="font-medium text-red-400 text-lg">The first full-scale war between Israel and Iran</span>
      </div>
      <div class="space-y-4">
        <div class="flex gap-3">
          <span class="text-text-muted text-sm font-mono w-[8.5rem] flex-shrink-0">13 June 2025</span>
          <p class="text-text-secondary text-sm">Israel launches surprise attack on Iranian military and nuclear sites. Top IRGC commanders and nuclear scientists assassinated.</p>
        </div>
        <div class="flex gap-3">
          <span class="text-text-muted text-sm font-mono w-[8.5rem] flex-shrink-0">13–21 June 2025</span>
          <p class="text-text-secondary text-sm">Iran retaliates with 550+ ballistic missiles and 1,000+ drones targeting Israel. Iron Dome and allies intercept most.</p>
        </div>
        <div class="flex gap-3">
          <span class="text-red-400 text-sm font-mono w-[8.5rem] flex-shrink-0">22 June 2025</span>
          <p class="text-text-secondary text-sm"><strong class="text-red-400">US enters the war.</strong> Bombs 3 Iranian nuclear sites — Natanz, Isfahan, Fordow. The facilities Iran spent decades building.</p>
        </div>
        <div class="flex gap-3">
          <span class="text-text-muted text-sm font-mono w-[8.5rem] flex-shrink-0">23 June 2025</span>
          <p class="text-text-secondary text-sm">Iran strikes US base at Al Udeid, Qatar. America is now a direct combatant.</p>
        </div>
        <div class="flex gap-3">
          <span class="text-primary text-sm font-mono w-[8.5rem] flex-shrink-0">24 June 2025</span>
          <p class="text-text-secondary text-sm"><strong class="text-primary">Ceasefire agreed.</strong> But nothing is resolved.</p>
        </div>
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-4 fade-in">
      <div class="bg-bg-card border border-red-500/30 rounded-xl p-5 text-center">
        <p class="text-3xl font-bold text-red-400 mb-1">~1,060–1,190</p>
        <p class="text-text-muted text-sm">Iranian casualties</p>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-xl p-5 text-center">
        <p class="text-3xl font-bold text-white mb-1">33</p>
        <p class="text-text-muted text-sm">Israeli casualties</p>
      </div>
    </div>
  </section>

  <!-- Road to Today -->
  <section class="mb-12 md:mb-20">
    <h2 class="text-2xl font-bold mb-6 fade-in">The Road to Today — 2026 Crisis</h2>
    <div class="space-y-4 stagger-children">
      <div class="flex items-start gap-4 bg-bg-card border border-border-subtle rounded-xl p-5">
        <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm flex-shrink-0">1</span>
        <div>
          <h3 class="font-medium text-white">Late December 2025 — Protests Erupt</h3>
          <p class="text-text-muted text-sm mt-1">Massive anti-government protests across Iran. The largest since the 1979 revolution. Iranians demand regime change.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 bg-bg-card border border-red-500/30 rounded-xl p-5">
        <span class="w-8 h-8 bg-red-500/20 rounded-full flex items-center justify-center text-red-400 font-bold text-sm flex-shrink-0">2</span>
        <div>
          <h3 class="font-medium text-red-400">January 2026 — Massacre of Protesters</h3>
          <p class="text-text-muted text-sm mt-1">Iranian government kills 3,000–7,000+ protesters. The world watches in horror.</p>
        </div>
      </div>
      <div class="flex items-start gap-4 bg-bg-card border border-border-subtle rounded-xl p-5">
        <span class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 font-bold text-sm flex-shrink-0">3</span>
        <div>
          <h3 class="font-medium text-white">13 January 2026 — Trump Backs Protesters</h3>
